<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LaserWorks.Desktop.ViewModels"
             xmlns:l="using:LaserWorks.Desktop"
             x:Class="LaserWorks.Desktop.Controls.Pager"
             x:DataType="vm:IListPage">
  <DockPanel Margin="0,8,0,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
      <TextBlock Text="{l:T List.PageSize}" VerticalAlignment="Center" Classes="muted" Margin="0,0,4,0" />
      <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Width="78" />
      <Button Command="{Binding FirstPageCommand}" Padding="6,4" ToolTip.Tip="{l:T List.First}">«</Button>
      <Button Command="{Binding PrevPageCommand}" Padding="6,4" ToolTip.Tip="{l:T List.Previous}">
        <l:Ico Data="{StaticResource IcoChevronLeft}" Width="14" Height="14" Foreground="{DynamicResource TextBrush}" />
      </Button>
      <Button Command="{Binding NextPageCommand}" Padding="6,4" ToolTip.Tip="{l:T List.Next}">
        <l:Ico Data="{StaticResource IcoChevronRight}" Width="14" Height="14" Foreground="{DynamicResource TextBrush}" />
      </Button>
      <Button Command="{Binding LastPageCommand}" Padding="6,4" ToolTip.Tip="{l:T List.Last}">»</Button>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <ProgressBar IsIndeterminate="True" Width="60" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
      <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" Classes="muted" />
    </StackPanel>
  </DockPanel>
</UserControl>
