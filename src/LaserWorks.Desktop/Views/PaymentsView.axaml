<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LaserWorks.Desktop.ViewModels"
             xmlns:c="using:LaserWorks.Desktop.Controls"
             xmlns:l="using:LaserWorks.Desktop"
             x:Class="LaserWorks.Desktop.Views.PaymentsView"
             x:DataType="vm:PaymentsViewModel">
  <DockPanel>
    <c:ListToolbar DockPanel.Dock="Top" Grid="{Binding #grid}" Margin="0,0,0,10">
      <c:ListToolbar.Actions>
        <Button Classes="primary" Command="{Binding NewCommand}" IsVisible="{Binding CanCreate}">
          <StackPanel Orientation="Horizontal" Spacing="6"><l:Ico Data="{StaticResource IcoMoney}" Foreground="White" /><TextBlock Text="{l:T Payment.Record}" /></StackPanel>
        </Button>
      </c:ListToolbar.Actions>
    </c:ListToolbar>
    <c:Pager DockPanel.Dock="Bottom" />
    <DataGrid Name="grid" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{l:T Col.Number}" Binding="{Binding Number}" Width="110" MinWidth="110" />
        <DataGridTextColumn Header="{l:T Col.Date}" Binding="{Binding Date, Converter={x:Static l:Conv.Date}}" Width="95" MinWidth="95" />
        <DataGridTextColumn Header="{l:T Col.Customer}" Binding="{Binding Customer}" Width="2*" MinWidth="140" />
        <DataGridTextColumn Header="{l:T Col.Invoice}" Binding="{Binding InvoiceNumber}" Width="110" MinWidth="110" />
        <DataGridTextColumn Header="{l:T Col.Method}" Binding="{Binding Method, Converter={x:Static l:Conv.Enum}}" Width="90" MinWidth="90" />
        <DataGridTextColumn Header="{l:T Col.Reference}" Binding="{Binding Reference}" Width="*" MinWidth="80" />
        <DataGridTextColumn Header="{l:T Col.Amount}" Binding="{Binding Amount, Converter={x:Static l:Conv.Money}}" Width="120" MinWidth="120" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
