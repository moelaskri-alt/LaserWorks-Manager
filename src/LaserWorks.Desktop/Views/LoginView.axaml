<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LaserWorks.Desktop.ViewModels"
             xmlns:l="using:LaserWorks.Desktop"
             x:Class="LaserWorks.Desktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">
  <Grid ColumnDefinitions="*,*">
    <Border Background="{DynamicResource SidebarBrush}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" MaxWidth="420" Margin="30">
        <Image Source="avares://LaserWorksManager/Assets/logo128.png" Width="96" Height="96" HorizontalAlignment="Left" />
        <TextBlock Text="LaserWorks Manager" Foreground="White" FontSize="30" FontWeight="SemiBold" />
        <TextBlock Text="{l:T Login.Tagline}" Foreground="{DynamicResource SidebarTextBrush}" FontSize="15" TextWrapping="Wrap" TextTrimming="None" />
        <TextBlock Text="{l:T Login.Question}" Foreground="{DynamicResource SidebarGroupBrush}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" Margin="0,20,0,0" />
      </StackPanel>
    </Border>
    <Grid Grid.Column="1">
      <Button Classes="ghost" Command="{Binding ToggleLanguageCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <l:Ico Data="{StaticResource IcoGlobe}" Foreground="{DynamicResource MutedBrush}" />
          <TextBlock Text="{l:T Shell.OtherLanguage}" />
        </StackPanel>
      </Button>
      <Border Classes="card" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
        <StackPanel Spacing="4">
          <TextBlock Text="{l:T Login.Title}" Classes="h1" />
          <TextBlock Text="{Binding CompanyName}" Classes="muted" Margin="0,0,0,16" />
          <TextBlock Text="{l:T Login.Username}" Classes="label" />
          <TextBox Text="{Binding Username}" Name="txtUsername" Margin="0,0,0,10" />
          <TextBlock Text="{l:T Login.Password}" Classes="label" />
          <TextBox Text="{Binding Password}" PasswordChar="●" Name="txtPassword" Margin="0,0,0,14" />
          <Border Classes="banner-error" IsVisible="{Binding ErrorMessage, Converter={x:Static l:Conv.NotEmpty}}" Margin="0,0,0,10">
            <TextBlock Classes="error" Text="{Binding ErrorMessage}" />
          </Border>
          <Button Classes="primary" Content="{l:T Login.SignIn}" Command="{Binding LoginCommand}" IsDefault="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36" Name="btnLogin" />
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Margin="0,8,0,0" />
          <TextBlock Text="{Binding Version}" Classes="muted small" HorizontalAlignment="Center" Margin="0,16,0,0" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
