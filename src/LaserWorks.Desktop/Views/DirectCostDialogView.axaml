<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LaserWorks.Desktop.ViewModels"
             xmlns:l="using:LaserWorks.Desktop"
             x:Class="LaserWorks.Desktop.Views.DirectCostDialogView"
             x:DataType="vm:DirectCostDialogViewModel">
  <StackPanel Spacing="4">
    <Border Classes="soft" Margin="0,0,0,8"><TextBlock Classes="wrap" FontWeight="SemiBold" Text="{Binding LineText}" /></Border>
    <TextBlock Classes="muted small wrap" Text="{l:T Component.DirectCostHint}" Margin="0,0,0,8" />
    <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto,Auto,Auto">
      <StackPanel Classes="field"><TextBlock Classes="label" Text="{l:T Col.Date}" /><CalendarDatePicker SelectedDate="{Binding Date}" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" HorizontalAlignment="Stretch" /></StackPanel>
      <StackPanel Classes="field" Grid.Column="2"><TextBlock Classes="label" Text="{l:T Col.Quantity}" /><NumericUpDown Value="{Binding Quantity}" Minimum="0" Name="numDcQty" /></StackPanel>
      <StackPanel Classes="field" Grid.Row="1"><TextBlock Classes="label" Text="{l:T Col.AmountExclTax}" /><NumericUpDown Value="{Binding Amount}" Minimum="0" Name="numDcAmount" /></StackPanel>
      <StackPanel Classes="field" Grid.Row="1" Grid.Column="2"><TextBlock Classes="label" Text="{l:T Col.Tax}" /><NumericUpDown Value="{Binding TaxAmount}" Minimum="0" /></StackPanel>
      <StackPanel Classes="field" Grid.Row="2"><TextBlock Classes="label" Text="{l:T Col.PaymentMethod}" />
        <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}" HorizontalAlignment="Stretch" Name="cmbDcMethod">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={x:Static l:Conv.Enum}}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox></StackPanel>
      <StackPanel Classes="field" Grid.Row="2" Grid.Column="2"><TextBlock Classes="label" Text="{l:T Col.Supplier}" /><ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Supplier}" HorizontalAlignment="Stretch" /></StackPanel>
      <StackPanel Classes="field" Grid.Row="3"><TextBlock Classes="label" Text="{l:T Col.Reference}" /><TextBox Text="{Binding Reference}" /></StackPanel>
      <StackPanel Classes="field" Grid.Row="3" Grid.Column="2"><TextBlock Classes="label" Text="{l:T Col.Total}" /><TextBlock Text="{Binding Total, Converter={x:Static l:Conv.Money}}" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel>
    </Grid>
    <StackPanel Classes="field"><TextBlock Classes="label" Text="{l:T Col.Notes}" /><TextBox Text="{Binding Notes}" Classes="multiline" /></StackPanel>
  </StackPanel>
</UserControl>
