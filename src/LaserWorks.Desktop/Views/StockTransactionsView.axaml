<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LaserWorks.Desktop.ViewModels"
             xmlns:c="using:LaserWorks.Desktop.Controls"
             xmlns:l="using:LaserWorks.Desktop"
             x:Class="LaserWorks.Desktop.Views.StockTransactionsView"
             x:DataType="vm:StockTransactionsViewModel">
  <DockPanel>
    <c:ListToolbar DockPanel.Dock="Top" Grid="{Binding #grid}" Margin="0,0,0,10">
      <c:ListToolbar.Filters>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" Width="170" />
          <CalendarDatePicker SelectedDate="{Binding From}" Width="130" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" />
          <CalendarDatePicker SelectedDate="{Binding To}" Width="130" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" />
        </StackPanel>
      </c:ListToolbar.Filters>
      <c:ListToolbar.Actions>
        <Button Classes="primary" Content="{l:T Stock.NewMovement}">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="{l:T Stock.Opening}" Command="{Binding MovementCommand}" CommandParameter="Opening" />
              <MenuItem Header="{l:T Stock.Adjust}" Command="{Binding MovementCommand}" CommandParameter="Adjust" />
              <MenuItem Header="{l:T Stock.IssueToJob}" Command="{Binding MovementCommand}" CommandParameter="IssueToJob" />
              <MenuItem Header="{l:T Stock.ReturnFromJob}" Command="{Binding MovementCommand}" CommandParameter="ReturnFromJob" />
              <MenuItem Header="{l:T Stock.Transfer}" Command="{Binding MovementCommand}" CommandParameter="Transfer" />
              <MenuItem Header="{l:T Stock.Scrap}" Command="{Binding MovementCommand}" CommandParameter="Scrap" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </c:ListToolbar.Actions>
    </c:ListToolbar>
    <c:Pager DockPanel.Dock="Bottom" />
    <DataGrid Name="grid" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{l:T Col.Number}" Binding="{Binding Number}" Width="100" MinWidth="100" />
        <DataGridTextColumn Header="{l:T Col.Date}" Binding="{Binding Date, Converter={x:Static l:Conv.Date}}" Width="95" MinWidth="95" />
        <DataGridTextColumn Header="{l:T Col.Type}" Binding="{Binding Type, Converter={x:Static l:Conv.Enum}}" Width="140" MinWidth="140" />
        <DataGridTextColumn Header="{l:T Col.Material}" Binding="{Binding MaterialName}" Width="1.8*" MinWidth="126" />
        <DataGridTextColumn Header="{l:T Col.Remnant}" Binding="{Binding RemnantCode}" Width="90" MinWidth="90" />
        <DataGridTextColumn Header="{l:T Col.Warehouse}" Binding="{Binding Warehouse}" Width="*" MinWidth="80" />
        <DataGridTextColumn Header="{l:T Col.Quantity}" Binding="{Binding Quantity, Converter={x:Static l:Conv.Number}}" Width="80" MinWidth="80" />
        <DataGridTextColumn Header="{l:T Col.UnitCost}" Binding="{Binding UnitCost, Converter={x:Static l:Conv.Money}}" Width="90" MinWidth="90" />
        <DataGridTextColumn Header="{l:T Col.Value}" Binding="{Binding TotalCost, Converter={x:Static l:Conv.Money}}" Width="100" MinWidth="100" />
        <DataGridTextColumn Header="{l:T Col.BalanceAfter}" Binding="{Binding QuantityAfter, Converter={x:Static l:Conv.Number}}" Width="90" MinWidth="90" />
        <DataGridTextColumn Header="{l:T Col.Job}" Binding="{Binding JobNumber}" Width="90" MinWidth="90" />
        <DataGridTextColumn Header="{l:T Col.Reference}" Binding="{Binding Reference}" Width="90" MinWidth="90" />
        <DataGridTextColumn Header="{l:T Col.Entry}" Binding="{Binding JournalNumber}" Width="90" MinWidth="90" />
        <DataGridTextColumn Header="{l:T Col.User}" Binding="{Binding CreatedBy}" Width="80" MinWidth="80" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
