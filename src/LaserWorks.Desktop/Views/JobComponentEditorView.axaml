<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LaserWorks.Desktop.ViewModels"
             xmlns:l="using:LaserWorks.Desktop"
             x:Class="LaserWorks.Desktop.Views.JobComponentEditorView"
             x:DataType="vm:JobComponentEditorViewModel">
  <StackPanel Spacing="4">
    <Border Classes="banner-warning" IsVisible="{Binding Locked}" Margin="0,0,0,8"><TextBlock Classes="wrap" Text="{l:T Component.LockedHint}" /></Border>
    <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
      <StackPanel Classes="field"><TextBlock Classes="label" Text="{l:T Col.Source}" />
        <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" IsEnabled="{Binding CanChangeIdentity}" HorizontalAlignment="Stretch" Name="cmbCompSource">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={x:Static l:Conv.Enum}}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox></StackPanel>
      <StackPanel Classes="field" Grid.Column="2"><TextBlock Classes="label" Text="{l:T Col.Type}" />
        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" IsEnabled="{Binding CanChangeIdentity}" HorizontalAlignment="Stretch" Name="cmbCompCategory">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={x:Static l:Conv.Enum}}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox></StackPanel>
      <StackPanel Classes="field" Grid.Row="1" Grid.ColumnSpan="3"><TextBlock Classes="label" Text="{l:T Col.Item}" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Margin="6,0,0,0" Command="{Binding NewItemCommand}" IsEnabled="{Binding CanChangeIdentity}" ToolTip.Tip="{l:T Component.NewItemTip}" Name="btnCompNewItem">
            <StackPanel Orientation="Horizontal" Spacing="4"><l:Ico Data="{StaticResource IcoPlus}" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="{l:T Component.NewItem}" /></StackPanel>
          </Button>
          <ComboBox ItemsSource="{Binding ItemChoices}" SelectedItem="{Binding Material}" IsEnabled="{Binding CanChangeIdentity}" HorizontalAlignment="Stretch" PlaceholderText="{l:T Component.NoItem}" Name="cmbCompItem" />
        </DockPanel></StackPanel>
      <StackPanel Classes="field" Grid.Row="2" Grid.ColumnSpan="3"><TextBlock Classes="label" Text="{l:T Col.Description}" /><TextBox Text="{Binding Description}" Name="txtCompDescription" /></StackPanel>
      <StackPanel Classes="field" Grid.Row="3"><TextBlock Classes="label" Text="{l:T Col.PlannedQty}" /><NumericUpDown Value="{Binding PlannedQuantity}" Minimum="0" Name="numCompQty" /></StackPanel>
      <StackPanel Classes="field" Grid.Row="3" Grid.Column="2"><TextBlock Classes="label" Text="{l:T Col.Unit}" /><TextBox Text="{Binding Unit}" /></StackPanel>
      <StackPanel Classes="field" Grid.Row="4"><TextBlock Classes="label" Text="{l:T Col.EstimatedUnitCost}" /><NumericUpDown Value="{Binding EstimatedUnitCost}" Minimum="0" IsEnabled="{Binding !FromEstimate}" Name="numCompUnitCost" /></StackPanel>
      <StackPanel Classes="field" Grid.Row="4" Grid.Column="2"><TextBlock Classes="label" Text="{l:T Col.EstimatedCost}" />
        <TextBlock Text="{Binding EstimatedCost, Converter={x:Static l:Conv.Money}}" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel>
      <StackPanel Classes="field" Grid.Row="5" Grid.ColumnSpan="3" IsVisible="{Binding IsDirect}"><TextBlock Classes="label" Text="{l:T Col.Supplier}" />
        <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Supplier}" HorizontalAlignment="Stretch" /></StackPanel>
    </Grid>
    <TextBlock Classes="muted small wrap" Text="{l:T Component.FromEstimateHint}" IsVisible="{Binding FromEstimate}" />
    <StackPanel Classes="field"><TextBlock Classes="label" Text="{l:T Col.Notes}" /><TextBox Text="{Binding Notes}" Classes="multiline" /></StackPanel>
  </StackPanel>
</UserControl>
