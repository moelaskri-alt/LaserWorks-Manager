<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LaserWorks.Desktop.ViewModels"
             xmlns:l="using:LaserWorks.Desktop"
             x:Class="LaserWorks.Desktop.Views.UserEditorView"
             x:DataType="vm:UserEditorViewModel">
  <StackPanel>
    <StackPanel Classes="field"><TextBlock Classes="label" Text="{l:T Login.Username}" /><TextBox Text="{Binding Username}" IsEnabled="{Binding IsNew}" /></StackPanel>
    <StackPanel Classes="field"><TextBlock Classes="label" Text="{l:T Col.FullName}" /><TextBox Text="{Binding FullName}" /></StackPanel>
    <StackPanel Classes="field"><TextBlock Classes="label" Text="{l:T Col.Role}" />
      <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={x:Static l:Conv.Enum}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
    <StackPanel Classes="field" IsVisible="{Binding IsNew}"><TextBlock Classes="label" Text="{l:T Login.Password}" /><TextBox Text="{Binding Password}" PasswordChar="●" />
      <TextBlock Classes="muted small wrap" Text="{l:T Err.PasswordPolicy}" /></StackPanel>
    <CheckBox IsChecked="{Binding IsActive}" Content="{l:T Col.Active}" IsVisible="{Binding !IsNew}" />
  </StackPanel>
</UserControl>
