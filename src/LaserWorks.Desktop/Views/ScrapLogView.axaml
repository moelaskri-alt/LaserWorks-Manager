<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LaserWorks.Desktop.ViewModels"
             xmlns:c="using:LaserWorks.Desktop.Controls"
             xmlns:l="using:LaserWorks.Desktop"
             x:Class="LaserWorks.Desktop.Views.ScrapLogView"
             x:DataType="vm:ScrapLogViewModel">
  <DockPanel>
    <c:ListToolbar DockPanel.Dock="Top" Grid="{Binding #grid}" Margin="0,0,0,10">
      <c:ListToolbar.Filters><ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" Width="170" /></c:ListToolbar.Filters>
      <c:ListToolbar.Actions>
        <Button Content="{l:T Col.Job}" Command="{Binding OpenJobCommand}" CommandParameter="{Binding Selected}" IsEnabled="{Binding Selected, Converter={x:Static l:Conv.NotNull}}" />
      </c:ListToolbar.Actions>
    </c:ListToolbar>
    <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{l:T Scrap.LogHint}" Margin="0,0,0,8" />
    <c:Pager DockPanel.Dock="Bottom" />
    <DataGrid Name="grid" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" l:GridBehaviors.OpenCommand="{Binding OpenJobCommand}" l:GridBehaviors.RowClasses="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{l:T Col.Number}" Binding="{Binding Number}" Width="100" MinWidth="100" />
        <DataGridTextColumn Header="{l:T Col.Date}" Binding="{Binding Date, Converter={x:Static l:Conv.Date}}" Width="95" MinWidth="95" />
        <DataGridTextColumn Header="{l:T Col.Type}" Binding="{Binding Type, Converter={x:Static l:Conv.Enum}}" Width="*" MinWidth="80" />
        <DataGridTextColumn Header="{l:T Col.Job}" Binding="{Binding JobNumber}" Width="100" MinWidth="100" />
        <DataGridTextColumn Header="{l:T Col.Operation}" Binding="{Binding Operation}" Width="*" MinWidth="80" />
        <DataGridTextColumn Header="{l:T Col.Material}" Binding="{Binding Material}" Width="1.3*" MinWidth="91" />
        <DataGridTextColumn Header="{l:T Col.Machine}" Binding="{Binding Machine}" Width="*" MinWidth="80" />
        <DataGridTextColumn Header="{l:T Col.Quantity}" Binding="{Binding Quantity, Converter={x:Static l:Conv.Number}}" Width="70" MinWidth="70" />
        <DataGridTextColumn Header="{l:T Col.Hours}" Binding="{Binding Hours, Converter={x:Static l:Conv.Number}}" Width="60" MinWidth="60" />
        <DataGridTextColumn Header="{l:T Col.Reason}" Binding="{Binding Reason}" Width="2*" MinWidth="140" />
        <DataGridTextColumn Header="{l:T Col.Cost}" Binding="{Binding Cost, Converter={x:Static l:Conv.Money}}" Width="100" MinWidth="100" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
