<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LaserWorks.Desktop.ViewModels"
             xmlns:l="using:LaserWorks.Desktop"
             x:Class="LaserWorks.Desktop.Views.SupplierPaymentDialogView"
             x:DataType="vm:SupplierPaymentDialogViewModel">
  <StackPanel>
    <StackPanel Classes="field"><TextBlock Classes="label" Text="{l:T Col.Supplier}" /><ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Supplier}" /></StackPanel>
    <StackPanel Classes="field"><TextBlock Classes="label" Text="{l:T Col.Invoice}" /><ComboBox ItemsSource="{Binding Invoices}" SelectedItem="{Binding Invoice}" /></StackPanel>
    <Grid ColumnDefinitions="*,12,*">
      <StackPanel Classes="field"><TextBlock Classes="label" Text="{l:T Col.Amount}" /><NumericUpDown Value="{Binding Amount}" Minimum="0" /></StackPanel>
      <StackPanel Classes="field" Grid.Column="2"><TextBlock Classes="label" Text="{l:T Col.Method}" />
        <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={x:Static l:Conv.Enum}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
    </Grid>
    <Grid ColumnDefinitions="*,12,*">
      <StackPanel Classes="field"><TextBlock Classes="label" Text="{l:T Col.Date}" /><CalendarDatePicker SelectedDate="{Binding Date}" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" /></StackPanel>
      <StackPanel Classes="field" Grid.Column="2"><TextBlock Classes="label" Text="{l:T Col.Reference}" /><TextBox Text="{Binding Reference}" /></StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
