<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LaserWorks.Desktop.ViewModels"
             xmlns:l="using:LaserWorks.Desktop"
             x:Class="LaserWorks.Desktop.Views.ChangePasswordView"
             x:DataType="vm:ChangePasswordViewModel">
  <StackPanel>
    <Border Classes="banner-warning" IsVisible="{Binding Forced}" Margin="0,0,0,10"><TextBlock Classes="wrap" Text="{l:T Account.MustChange}" /></Border>
    <StackPanel Classes="field"><TextBlock Classes="label" Text="{l:T Account.CurrentPassword}" /><TextBox Text="{Binding CurrentPassword}" PasswordChar="●" /></StackPanel>
    <StackPanel Classes="field"><TextBlock Classes="label" Text="{l:T Account.NewPassword}" /><TextBox Text="{Binding NewPassword}" PasswordChar="●" /></StackPanel>
    <StackPanel Classes="field"><TextBlock Classes="label" Text="{l:T Account.ConfirmPassword}" /><TextBox Text="{Binding ConfirmPassword}" PasswordChar="●" /></StackPanel>
    <TextBlock Classes="muted small wrap" Text="{l:T Err.PasswordPolicy}" />
  </StackPanel>
</UserControl>
