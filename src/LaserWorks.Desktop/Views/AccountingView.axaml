<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LaserWorks.Desktop.ViewModels"
             xmlns:l="using:LaserWorks.Desktop"
             x:Class="LaserWorks.Desktop.Views.AccountingView"
             x:DataType="vm:AccountingViewModel">
  <TabControl SelectedIndex="{Binding SelectedTab}">
    <TabItem Header="{l:T Accounting.Chart}"><ContentControl Content="{Binding Chart}" Margin="0,10,0,0" /></TabItem>
    <TabItem Header="{l:T Accounting.Journals}"><ContentControl Content="{Binding Journals}" Margin="0,10,0,0" /></TabItem>
    <TabItem Header="{l:T Accounting.Ledger}"><ContentControl Content="{Binding Ledger}" Margin="0,10,0,0" /></TabItem>
    <TabItem Header="{l:T Rpt.TrialBalance}"><ContentControl Content="{Binding TrialBalance}" Margin="0,10,0,0" /></TabItem>
    <TabItem Header="{l:T Accounting.Periods}"><ContentControl Content="{Binding Periods}" Margin="0,10,0,0" /></TabItem>
    <TabItem Header="{l:T Accounting.Reconciliation}"><ContentControl Content="{Binding Reconciliation}" Margin="0,10,0,0" /></TabItem>
  </TabControl>
</UserControl>
