<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LaserWorks.Desktop.ViewModels"
             xmlns:c="using:LaserWorks.Desktop.Controls"
             xmlns:l="using:LaserWorks.Desktop"
             x:Class="LaserWorks.Desktop.Views.MachinesView"
             x:DataType="vm:MachinesViewModel">
  <DockPanel>
    <c:ListToolbar DockPanel.Dock="Top" Grid="{Binding #grid}" Margin="0,0,0,10">
      <c:ListToolbar.Actions>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Command="{Binding OpenCommand}" CommandParameter="{Binding Selected}" IsEnabled="{Binding Selected, Converter={x:Static l:Conv.NotNull}}">
            <StackPanel Orientation="Horizontal" Spacing="6"><l:Ico Data="{StaticResource IcoEdit}" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="{l:T Common.Edit}" /></StackPanel>
          </Button>
          <Button Classes="danger" Command="{Binding DeleteCommand}" CommandParameter="{Binding Selected}" IsEnabled="{Binding Selected, Converter={x:Static l:Conv.NotNull}}" IsVisible="{Binding CanDelete}">
            <l:Ico Data="{StaticResource IcoDelete}" Foreground="{DynamicResource DangerBrush}" /></Button>
          <Button Classes="primary" Command="{Binding NewCommand}" IsVisible="{Binding CanCreate}" Name="btnNewMachine">
            <StackPanel Orientation="Horizontal" Spacing="6"><l:Ico Data="{StaticResource IcoPlus}" Foreground="White" /><TextBlock Text="{l:T Machine.New}" /></StackPanel>
          </Button>
        </StackPanel>
      </c:ListToolbar.Actions>
    </c:ListToolbar>
    <c:Pager DockPanel.Dock="Bottom" />
    <DataGrid Name="grid" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" l:GridBehaviors.OpenCommand="{Binding OpenCommand}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{l:T Col.Code}" Binding="{Binding Code}" Width="100" MinWidth="100" />
        <DataGridTextColumn Header="{l:T Col.Name}" Binding="{Binding Name}" Width="2*" MinWidth="140" />
        <DataGridTextColumn Header="{l:T Col.Type}" Binding="{Binding MachineType}" Width="1.5*" MinWidth="105" />
        <DataGridTextColumn Header="{l:T Machine.PowerWatts}" Binding="{Binding LaserPowerWatts, Converter={x:Static l:Conv.Number}}" Width="100" MinWidth="100" />
        <DataGridTextColumn Header="{l:T Col.HourlyRate}" Binding="{Binding HourlyRate, Converter={x:Static l:Conv.Money}}" Width="120" MinWidth="120" />
        <DataGridCheckBoxColumn Header="{l:T Machine.Overridden}" Binding="{Binding Overridden}" Width="100" MinWidth="100" />
        <DataGridCheckBoxColumn Header="{l:T Col.Active}" Binding="{Binding IsActive}" Width="70" MinWidth="70" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
