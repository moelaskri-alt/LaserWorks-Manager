<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LaserWorks.Desktop.ViewModels"
             xmlns:l="using:LaserWorks.Desktop"
             x:Class="LaserWorks.Desktop.Views.LaserParametersView"
             x:DataType="vm:LaserParametersViewModel">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
        <Button Content="{l:T Common.Edit}" Command="{Binding OpenCommand}" CommandParameter="{Binding Selected}" IsEnabled="{Binding Selected, Converter={x:Static l:Conv.NotNull}}" />
        <Button Classes="danger" Command="{Binding DeleteCommand}" CommandParameter="{Binding Selected}" IsEnabled="{Binding Selected, Converter={x:Static l:Conv.NotNull}}">
          <l:Ico Data="{StaticResource IcoDelete}" Foreground="{DynamicResource DangerBrush}" /></Button>
        <Button Classes="primary" Content="{l:T LaserParam.New}" Command="{Binding NewCommand}" />
      </StackPanel>
      <TextBox Text="{Binding Search}" Watermark="{l:T Common.SearchHint}" Width="300" HorizontalAlignment="Left" />
    </DockPanel>
    <Border DockPanel.Dock="Top" Classes="banner-warning" Margin="0,0,0,8"><TextBlock Classes="wrap" Text="{l:T LaserParam.ReferenceOnly}" /></Border>
    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" l:GridBehaviors.OpenCommand="{Binding OpenCommand}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{l:T Col.Material}" Binding="{Binding Material}" Width="2*" MinWidth="140" />
        <DataGridTextColumn Header="{l:T Col.Machine}" Binding="{Binding Machine}" Width="1.5*" MinWidth="105" />
        <DataGridTextColumn Header="{l:T Col.Thickness}" Binding="{Binding Thickness, Converter={x:Static l:Conv.Number}}" Width="80" MinWidth="80" />
        <DataGridTextColumn Header="{l:T Col.Operation}" Binding="{Binding Operation, Converter={x:Static l:Conv.Enum}}" Width="100" MinWidth="100" />
        <DataGridTextColumn Header="{l:T LaserParam.Power}" Binding="{Binding PowerPercent, Converter={x:Static l:Conv.Percent}}" Width="80" MinWidth="80" />
        <DataGridTextColumn Header="{l:T LaserParam.Speed}" Binding="{Binding Speed, Converter={x:Static l:Conv.Number}}" Width="100" MinWidth="100" />
        <DataGridTextColumn Header="{l:T LaserParam.Frequency}" Binding="{Binding Frequency}" Width="100" MinWidth="100" />
        <DataGridTextColumn Header="{l:T LaserParam.Passes}" Binding="{Binding Passes}" Width="70" MinWidth="70" />
        <DataGridTextColumn Header="{l:T Col.Notes}" Binding="{Binding Notes}" Width="2*" MinWidth="140" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
