<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LaserWorks.Desktop.ViewModels"
             xmlns:c="using:LaserWorks.Desktop.Controls"
             xmlns:l="using:LaserWorks.Desktop"
             x:Class="LaserWorks.Desktop.Views.PurchaseOrdersView"
             x:DataType="vm:PurchaseOrdersViewModel">
  <DockPanel>
    <c:ListToolbar DockPanel.Dock="Top" Grid="{Binding #grid}" Margin="0,0,0,10">
      <c:ListToolbar.Filters>
        <StackPanel Orientation="Horizontal" Spacing="8">

        </StackPanel>
      </c:ListToolbar.Filters>
      <c:ListToolbar.Actions>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="{l:T Common.Open}" Command="{Binding OpenCommand}" CommandParameter="{Binding Selected}" IsEnabled="{Binding Selected, Converter={x:Static l:Conv.NotNull}}" />
          <Button Classes="primary" Content="{l:T PO.New}" Command="{Binding NewCommand}" />
        </StackPanel>
      </c:ListToolbar.Actions>
    </c:ListToolbar>
    <c:Pager DockPanel.Dock="Bottom" />
    <DataGrid Name="grid" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" l:GridBehaviors.OpenCommand="{Binding OpenCommand}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{l:T Col.Number}" Binding="{Binding Number}" Width="110" MinWidth="110" />
        <DataGridTextColumn Header="{l:T Col.Date}" Binding="{Binding Date, Converter={x:Static l:Conv.Date}}" Width="95" MinWidth="95" />
        <DataGridTextColumn Header="{l:T Col.ExpectedDate}" Binding="{Binding ExpectedDate, Converter={x:Static l:Conv.Date}}" Width="110" MinWidth="110" />
        <DataGridTextColumn Header="{l:T Col.Supplier}" Binding="{Binding Supplier}" Width="2*" MinWidth="140" />
        <DataGridTextColumn Header="{l:T Col.Status}" Binding="{Binding Status, Converter={x:Static l:Conv.Enum}}" Width="130" MinWidth="130" />
        <DataGridTextColumn Header="{l:T Col.Subtotal}" Binding="{Binding Subtotal, Converter={x:Static l:Conv.Money}}" Width="120" MinWidth="120" />
        <DataGridTextColumn Header="{l:T Col.Tax}" Binding="{Binding TaxAmount, Converter={x:Static l:Conv.Money}}" Width="100" MinWidth="100" />
        <DataGridTextColumn Header="{l:T Col.Total}" Binding="{Binding Total, Converter={x:Static l:Conv.Money}}" Width="120" MinWidth="120" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
