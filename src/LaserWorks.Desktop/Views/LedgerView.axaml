<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LaserWorks.Desktop.ViewModels"
             xmlns:e="using:LaserWorks.Domain.Entities"
             xmlns:l="using:LaserWorks.Desktop"
             x:Class="LaserWorks.Desktop.Views.LedgerView"
             x:DataType="vm:LedgerViewModel">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12">
        <TextBlock VerticalAlignment="Center"><Run Text="{l:T Col.Balance}" /><Run Text=": " /><Run Text="{Binding ClosingBalance, Converter={x:Static l:Conv.Money}}" FontWeight="SemiBold" /></TextBlock>
        <Button Content="{l:T Nav.Reports}" Command="{Binding ReportCommand}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" Width="340">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="e:Account"><TextBlock><Run Text="{Binding Code}" /><Run Text="  " /><Run Text="{Binding Converter={x:Static l:Conv.BiName}}" /></TextBlock></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <CalendarDatePicker SelectedDate="{Binding From}" Width="130" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" />
        <CalendarDatePicker SelectedDate="{Binding To}" Width="130" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" />
      </StackPanel>
    </DockPanel>
    <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" l:GridBehaviors.OpenCommand="{Binding OpenEntryCommand}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{l:T Col.Date}" Binding="{Binding Date, Converter={x:Static l:Conv.Date}}" Width="95" MinWidth="95" />
        <DataGridTextColumn Header="{l:T Col.Entry}" Binding="{Binding EntryNumber}" Width="100" MinWidth="100" />
        <DataGridTextColumn Header="{l:T Col.Source}" Binding="{Binding SourceType}" Width="120" MinWidth="120" />
        <DataGridTextColumn Header="{l:T Col.Document}" Binding="{Binding SourceNumber}" Width="110" MinWidth="110" />
        <DataGridTextColumn Header="{l:T Col.Description}" Binding="{Binding Description}" Width="3*" MinWidth="160" />
        <DataGridTextColumn Header="{l:T Col.Debit}" Binding="{Binding Debit, Converter={x:Static l:Conv.Money}}" Width="110" MinWidth="110" />
        <DataGridTextColumn Header="{l:T Col.Credit}" Binding="{Binding Credit, Converter={x:Static l:Conv.Money}}" Width="110" MinWidth="110" />
        <DataGridTextColumn Header="{l:T Col.Balance}" Binding="{Binding Balance, Converter={x:Static l:Conv.Money}}" Width="120" MinWidth="120" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
