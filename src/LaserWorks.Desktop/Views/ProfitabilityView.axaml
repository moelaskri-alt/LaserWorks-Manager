<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LaserWorks.Desktop.ViewModels"
             xmlns:c="using:LaserWorks.Desktop.Controls"
             xmlns:l="using:LaserWorks.Desktop"
             x:Class="LaserWorks.Desktop.Views.ProfitabilityView"
             x:DataType="vm:ProfitabilityViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="GroupGrid" x:DataType="x:Object">
      <DataGrid ItemsSource="{Binding}" x:CompileBindings="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="{l:T Col.Code}" Binding="{Binding Key}" Width="100" MinWidth="100" />
          <DataGridTextColumn Header="{l:T Col.Name}" Binding="{Binding Name}" Width="2*" MinWidth="140" />
          <DataGridTextColumn Header="{l:T Col.Jobs}" Binding="{Binding Jobs}" Width="70" MinWidth="70" />
          <DataGridTextColumn Header="{l:T Col.Revenue}" Binding="{Binding Revenue, Converter={x:Static l:Conv.Money}}" Width="*" MinWidth="80" />
          <DataGridTextColumn Header="{l:T Col.Cost}" Binding="{Binding Cost, Converter={x:Static l:Conv.Money}}" Width="*" MinWidth="80" />
          <DataGridTextColumn Header="{l:T Col.GrossProfit}" Binding="{Binding GrossProfit, Converter={x:Static l:Conv.Money}}" Width="*" MinWidth="80" />
          <DataGridTextColumn Header="{l:T Col.Margin}" Binding="{Binding MarginPercent, Converter={x:Static l:Conv.Percent}}" Width="90" MinWidth="90" />
          <DataGridTextColumn Header="{l:T Col.MachineHours}" Binding="{Binding Hours, Converter={x:Static l:Conv.Number}}" Width="100" MinWidth="100" />
        </DataGrid.Columns>
      </DataGrid>
    </DataTemplate>
  </UserControl.Resources>
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
        <Button Content="{l:T Rpt.JobProfitability}" Command="{Binding ReportCommand}" CommandParameter="JobProfitability" />
        <Button Content="{l:T Rpt.EstimatedVsActual}" Command="{Binding ReportCommand}" CommandParameter="EstimatedVsActual" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <CalendarDatePicker SelectedDate="{Binding From}" Width="130" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" />
        <CalendarDatePicker SelectedDate="{Binding To}" Width="130" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" />
        <CheckBox IsChecked="{Binding CompletedOnly}" Content="{l:T Filter.CompletedOnly}" />
        <CheckBox IsChecked="{Binding FlaggedOnly}" Content="{l:T Filter.FlaggedOnly}" />
        <Button Classes="primary" Content="{l:T Common.Refresh}" Command="{Binding RefreshCommand}" />
        <ProgressBar IsIndeterminate="True" Width="60" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
      </StackPanel>
    </DockPanel>
    <Border DockPanel.Dock="Top" Classes="banner-error" IsVisible="{Binding ErrorMessage, Converter={x:Static l:Conv.NotEmpty}}" Margin="0,0,0,8"><TextBlock Classes="error" Text="{Binding ErrorMessage}" /></Border>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,10,*,10,*,10,*,10,*,10,*" Margin="0,0,0,10">
      <Border Classes="card"><StackPanel><TextBlock Classes="label" Text="{l:T Col.Revenue}" /><TextBlock Classes="kpi" Text="{Binding TotalRevenue, Converter={x:Static l:Conv.Money}}" /></StackPanel></Border>
      <Border Classes="card" Grid.Column="2"><StackPanel><TextBlock Classes="label" Text="{l:T Col.ActualCost}" /><TextBlock Classes="kpi" Text="{Binding TotalCost, Converter={x:Static l:Conv.Money}}" /></StackPanel></Border>
      <Border Classes="card" Grid.Column="4"><StackPanel><TextBlock Classes="label" Text="{l:T Col.GrossProfit}" /><TextBlock Classes="kpi" Text="{Binding TotalProfit, Converter={x:Static l:Conv.Money}}" Foreground="{Binding TotalProfit, Converter={x:Static l:Conv.SignBrush}}" /></StackPanel></Border>
      <Border Classes="card" Grid.Column="6"><StackPanel><TextBlock Classes="label" Text="{l:T Col.Margin}" /><TextBlock Classes="kpi" Text="{Binding TotalMargin, Converter={x:Static l:Conv.Percent}}" /></StackPanel></Border>
      <Border Classes="card" Grid.Column="8"><StackPanel><TextBlock Classes="label" Text="{l:T Profit.LossJobs}" /><TextBlock Classes="kpi" Text="{Binding LossJobs}" Foreground="{DynamicResource DangerBrush}" /></StackPanel></Border>
      <Border Classes="card" Grid.Column="10"><StackPanel><TextBlock Classes="label" Text="{l:T Profit.FlaggedJobs}" /><TextBlock Classes="kpi" Text="{Binding FlaggedJobs}" Foreground="{DynamicResource WarningBrush}" /></StackPanel></Border>
    </Grid>
    <TabControl SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="{l:T Profit.ByJob}">
        <DataGrid ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" Margin="0,8,0,0" l:GridBehaviors.OpenCommand="{Binding OpenJobCommand}" l:GridBehaviors.RowClasses="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{l:T Col.Job}" Binding="{Binding Row.JobNumber}" Width="95" MinWidth="95" />
            <DataGridTextColumn Header="{l:T Col.Customer}" Binding="{Binding Row.Customer}" Width="1.4*" MinWidth="98" />
            <DataGridTextColumn Header="{l:T Col.Status}" Binding="{Binding Row.Status, Converter={x:Static l:Conv.Enum}}" Width="95" MinWidth="95" />
            <DataGridTextColumn Header="{l:T Col.Revenue}" Binding="{Binding Row.Revenue, Converter={x:Static l:Conv.Money}}" Width="110" MinWidth="110" />
            <DataGridTextColumn Header="{l:T Col.EstimatedCost}" Binding="{Binding Row.EstimatedCost, Converter={x:Static l:Conv.Money}}" Width="110" MinWidth="110" />
            <DataGridTextColumn Header="{l:T Col.ActualCost}" Binding="{Binding Row.ActualCost, Converter={x:Static l:Conv.Money}}" Width="110" MinWidth="110" />
            <DataGridTextColumn Header="{l:T Col.GrossProfit}" Binding="{Binding Row.GrossProfit, Converter={x:Static l:Conv.Money}}" Width="110" MinWidth="110" />
            <DataGridTextColumn Header="{l:T Col.Margin}" Binding="{Binding Row.MarginPercent, Converter={x:Static l:Conv.Percent}}" Width="80" MinWidth="80" />
            <DataGridTextColumn Header="{l:T Col.MaterialVariancePct}" Binding="{Binding Row.MaterialVariancePercent, Converter={x:Static l:Conv.Percent}}" Width="90" MinWidth="90" />
            <DataGridTextColumn Header="{l:T Col.MachineVariancePct}" Binding="{Binding Row.MachineVariancePercent, Converter={x:Static l:Conv.Percent}}" Width="90" MinWidth="90" />
            <DataGridTextColumn Header="{l:T Col.ScrapPct}" Binding="{Binding Row.ScrapPercent, Converter={x:Static l:Conv.Percent}}" Width="70" MinWidth="70" />
            <DataGridTextColumn Header="{l:T Col.Flags}" Binding="{Binding FlagText}" Width="1.8*" MinWidth="126" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{l:T Profit.ByCustomer}"><ContentControl Content="{Binding Customers}" ContentTemplate="{StaticResource GroupGrid}" Margin="0,8,0,0" /></TabItem>
      <TabItem Header="{l:T Profit.ByMachine}"><ContentControl Content="{Binding Machines}" ContentTemplate="{StaticResource GroupGrid}" Margin="0,8,0,0" /></TabItem>
      <TabItem Header="{l:T Profit.ByMaterial}"><ContentControl Content="{Binding Materials}" ContentTemplate="{StaticResource GroupGrid}" Margin="0,8,0,0" /></TabItem>
      <TabItem Header="{l:T Profit.ByMonth}">
        <Grid RowDefinitions="220,*" Margin="0,8,0,0">
          <Border Classes="card"><c:Chart Kind="Column" Items="{Binding MonthChart}" /></Border>
          <ContentControl Grid.Row="1" Content="{Binding Months}" ContentTemplate="{StaticResource GroupGrid}" Margin="0,10,0,0" />
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
