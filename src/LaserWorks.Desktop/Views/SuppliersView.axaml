<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LaserWorks.Desktop.ViewModels"
             xmlns:c="using:LaserWorks.Desktop.Controls"
             xmlns:l="using:LaserWorks.Desktop"
             x:Class="LaserWorks.Desktop.Views.SuppliersView"
             x:DataType="vm:SuppliersViewModel">
  <DockPanel>
    <c:ListToolbar DockPanel.Dock="Top" Grid="{Binding #grid}" Margin="0,0,0,10">
      <c:ListToolbar.Filters>
        <StackPanel Orientation="Horizontal" Spacing="8">

        </StackPanel>
      </c:ListToolbar.Filters>
      <c:ListToolbar.Actions>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="{l:T Supplier.Pay}" Command="{Binding PayCommand}" CommandParameter="{Binding Selected}" IsEnabled="{Binding Selected, Converter={x:Static l:Conv.NotNull}}" />
          <Button Content="{l:T Common.Edit}" Command="{Binding OpenCommand}" CommandParameter="{Binding Selected}" IsEnabled="{Binding Selected, Converter={x:Static l:Conv.NotNull}}" />
          <Button Content="{l:T Common.Delete}" Command="{Binding DeleteCommand}" CommandParameter="{Binding Selected}" IsEnabled="{Binding Selected, Converter={x:Static l:Conv.NotNull}}" Classes="danger" />
          <Button Classes="primary" Content="{l:T Supplier.New}" Command="{Binding NewCommand}" />
        </StackPanel>
      </c:ListToolbar.Actions>
    </c:ListToolbar>
    <c:Pager DockPanel.Dock="Bottom" />
    <DataGrid Name="grid" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" l:GridBehaviors.ServerSort="True" l:GridBehaviors.OpenCommand="{Binding OpenCommand}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{l:T Col.Code}" Binding="{Binding Code}" SortMemberPath="Code" Width="100" MinWidth="100" />
        <DataGridTextColumn Header="{l:T Col.Name}" Binding="{Binding Name}" SortMemberPath="Name" Width="2*" MinWidth="140" />
        <DataGridTextColumn Header="{l:T Col.Phone}" Binding="{Binding Phone}" Width="130" MinWidth="130" />
        <DataGridTextColumn Header="{l:T Col.Email}" Binding="{Binding Email}" Width="1.4*" MinWidth="98" />
        <DataGridTextColumn Header="{l:T Col.PaymentTerms}" Binding="{Binding PaymentTermsDays}" Width="100" MinWidth="100" />
        <DataGridTextColumn Header="{l:T Col.Balance}" Binding="{Binding Balance, Converter={x:Static l:Conv.Money}}" Width="130" MinWidth="130" />
        <DataGridCheckBoxColumn Header="{l:T Col.Active}" Binding="{Binding IsActive}" Width="70" MinWidth="70" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
