<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LaserWorks.Desktop.ViewModels"
             xmlns:c="using:LaserWorks.Desktop.Controls"
             xmlns:l="using:LaserWorks.Desktop"
             x:Class="LaserWorks.Desktop.Views.JournalsView"
             x:DataType="vm:JournalsViewModel">
  <DockPanel>
    <c:ListToolbar DockPanel.Dock="Top" Grid="{Binding #grid}" Margin="0,0,0,10">
      <c:ListToolbar.Filters>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <CalendarDatePicker SelectedDate="{Binding From}" Width="130" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" />
          <CalendarDatePicker SelectedDate="{Binding To}" Width="130" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" />
          <CheckBox IsChecked="{Binding ManualOnly}" Content="{l:T Filter.ManualOnly}" />
        </StackPanel>
      </c:ListToolbar.Filters>
      <c:ListToolbar.Actions>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="{l:T Common.Open}" Command="{Binding OpenCommand}" CommandParameter="{Binding Selected}" IsEnabled="{Binding Selected, Converter={x:Static l:Conv.NotNull}}" />
          <Button Classes="primary" Content="{l:T Journal.New}" Command="{Binding NewCommand}" />
        </StackPanel>
      </c:ListToolbar.Actions>
    </c:ListToolbar>
    <c:Pager DockPanel.Dock="Bottom" />
    <DataGrid Name="grid" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" l:GridBehaviors.OpenCommand="{Binding OpenCommand}" l:GridBehaviors.RowClasses="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{l:T Col.Entry}" Binding="{Binding Number}" Width="100" MinWidth="100" />
        <DataGridTextColumn Header="{l:T Col.Date}" Binding="{Binding Date, Converter={x:Static l:Conv.Date}}" Width="95" MinWidth="95" />
        <DataGridTextColumn Header="{l:T Col.Description}" Binding="{Binding Description}" Width="3*" MinWidth="160" />
        <DataGridTextColumn Header="{l:T Col.Source}" Binding="{Binding SourceType, Converter={x:Static l:Conv.Source}}" Width="120" MinWidth="120" />
        <DataGridTextColumn Header="{l:T Col.Document}" Binding="{Binding SourceNumber}" Width="110" MinWidth="110" />
        <DataGridTextColumn Header="{l:T Col.Debit}" Binding="{Binding TotalDebit, Converter={x:Static l:Conv.Money}}" Width="110" MinWidth="110" />
        <DataGridTextColumn Header="{l:T Col.Credit}" Binding="{Binding TotalCredit, Converter={x:Static l:Conv.Money}}" Width="110" MinWidth="110" />
        <DataGridTextColumn Header="{l:T Col.Status}" Binding="{Binding Status, Converter={x:Static l:Conv.Enum}}" Width="90" MinWidth="90" />
        <DataGridTextColumn Header="{l:T Journal.ReversalOf}" Binding="{Binding ReversalOf}" Width="100" MinWidth="100" />
        <DataGridTextColumn Header="{l:T Journal.ReversedBy}" Binding="{Binding ReversedBy}" Width="100" MinWidth="100" />
        <DataGridTextColumn Header="{l:T Col.User}" Binding="{Binding PostedBy}" Width="90" MinWidth="90" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
