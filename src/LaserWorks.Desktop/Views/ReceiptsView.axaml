<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LaserWorks.Desktop.ViewModels"
             xmlns:c="using:LaserWorks.Desktop.Controls"
             xmlns:l="using:LaserWorks.Desktop"
             x:Class="LaserWorks.Desktop.Views.ReceiptsView"
             x:DataType="vm:ReceiptsViewModel">
  <DockPanel>
    <c:ListToolbar DockPanel.Dock="Top" Grid="{Binding #grid}" Margin="0,0,0,10">
      <c:ListToolbar.Filters>
        <StackPanel Orientation="Horizontal" Spacing="8">

        </StackPanel>
      </c:ListToolbar.Filters>
      <c:ListToolbar.Actions>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="{l:T Receipt.PostInvoice}" Command="{Binding InvoiceCommand}" CommandParameter="{Binding Selected}" IsEnabled="{Binding Selected, Converter={x:Static l:Conv.NotNull}}" />
          <Button Content="{l:T PurchaseReturn.Title}" Command="{Binding ReturnCommand}" CommandParameter="{Binding Selected}" IsEnabled="{Binding Selected, Converter={x:Static l:Conv.NotNull}}" />
          <Button Classes="primary" Content="{l:T Receipt.New}" Command="{Binding NewCommand}" />
        </StackPanel>
      </c:ListToolbar.Actions>
    </c:ListToolbar>
    <TextBlock DockPanel.Dock="Top" Classes="muted wrap" Text="{l:T Receipt.Hint}" Margin="0,0,0,8" />
    <c:Pager DockPanel.Dock="Bottom" />
    <DataGrid Name="grid" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" l:GridBehaviors.RowClasses="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{l:T Col.Number}" Binding="{Binding Number}" Width="110" MinWidth="110" />
        <DataGridTextColumn Header="{l:T Col.Date}" Binding="{Binding Date, Converter={x:Static l:Conv.Date}}" Width="95" MinWidth="95" />
        <DataGridTextColumn Header="{l:T Col.Supplier}" Binding="{Binding Supplier}" Width="2*" MinWidth="140" />
        <DataGridTextColumn Header="{l:T Col.PurchaseOrder}" Binding="{Binding PurchaseOrder}" Width="110" MinWidth="110" />
        <DataGridTextColumn Header="{l:T Col.Warehouse}" Binding="{Binding Warehouse}" Width="*" MinWidth="80" />
        <DataGridTextColumn Header="{l:T Col.Value}" Binding="{Binding Subtotal, Converter={x:Static l:Conv.Money}}" Width="120" MinWidth="120" />
        <DataGridCheckBoxColumn Header="{l:T Col.Invoiced}" Binding="{Binding IsInvoiced}" Width="80" MinWidth="80" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
