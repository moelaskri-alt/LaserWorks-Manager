<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LaserWorks.Desktop.ViewModels"
             xmlns:c="using:LaserWorks.Desktop.Controls"
             xmlns:l="using:LaserWorks.Desktop"
             x:Class="LaserWorks.Desktop.Views.ExpensesView"
             x:DataType="vm:ExpensesViewModel">
  <DockPanel>
    <c:ListToolbar DockPanel.Dock="Top" Grid="{Binding #grid}" Margin="0,0,0,10">
      <c:ListToolbar.Filters>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" Width="130" />
          <CalendarDatePicker SelectedDate="{Binding From}" Width="130" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" />
          <CalendarDatePicker SelectedDate="{Binding To}" Width="130" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" />
        </StackPanel>
      </c:ListToolbar.Filters>
      <c:ListToolbar.Actions>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="{l:T Common.Post}" Command="{Binding PostCommand}" CommandParameter="{Binding Selected}" IsEnabled="{Binding Selected, Converter={x:Static l:Conv.NotNull}}" />
          <Button Content="{l:T Expense.Cancel}" Command="{Binding CancelExpenseCommand}" CommandParameter="{Binding Selected}" IsEnabled="{Binding Selected, Converter={x:Static l:Conv.NotNull}}" />
          <Button Content="{l:T Common.Open}" Command="{Binding OpenCommand}" CommandParameter="{Binding Selected}" IsEnabled="{Binding Selected, Converter={x:Static l:Conv.NotNull}}" />
          <Button Classes="primary" Content="{l:T Expense.New}" Command="{Binding NewCommand}" />
        </StackPanel>
      </c:ListToolbar.Actions>
    </c:ListToolbar>
    <c:Pager DockPanel.Dock="Bottom" />
    <DataGrid Name="grid" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" l:GridBehaviors.ServerSort="True" l:GridBehaviors.OpenCommand="{Binding OpenCommand}" l:GridBehaviors.RowClasses="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{l:T Col.Number}" Binding="{Binding Number}" SortMemberPath="Number" Width="100" MinWidth="100" />
        <DataGridTextColumn Header="{l:T Col.Date}" Binding="{Binding Date, Converter={x:Static l:Conv.Date}}" SortMemberPath="Date" Width="95" MinWidth="95" />
        <DataGridTextColumn Header="{l:T Col.Category}" Binding="{Binding Category}" SortMemberPath="Category.Name" Width="*" MinWidth="80" />
        <DataGridTextColumn Header="{l:T Col.Description}" Binding="{Binding Description}" SortMemberPath="Description" Width="2*" MinWidth="140" />
        <DataGridTextColumn Header="{l:T Col.Amount}" Binding="{Binding Amount, Converter={x:Static l:Conv.Money}}" SortMemberPath="Amount" Width="110" MinWidth="110" />
        <DataGridTextColumn Header="{l:T Col.Tax}" Binding="{Binding TaxAmount, Converter={x:Static l:Conv.Money}}" Width="90" MinWidth="90" />
        <DataGridTextColumn Header="{l:T Col.Method}" Binding="{Binding PaymentMethod, Converter={x:Static l:Conv.Enum}}" Width="90" MinWidth="90" />
        <DataGridTextColumn Header="{l:T Col.Supplier}" Binding="{Binding Supplier}" Width="*" MinWidth="80" />
        <DataGridTextColumn Header="{l:T Col.Job}" Binding="{Binding JobNumber}" Width="90" MinWidth="90" />
        <DataGridTextColumn Header="{l:T Col.Machine}" Binding="{Binding Machine}" Width="*" MinWidth="80" />
        <DataGridTextColumn Header="{l:T Col.CostCenter}" Binding="{Binding CostCenter}" Width="*" MinWidth="80" />
        <DataGridTextColumn Header="{l:T Col.Status}" Binding="{Binding Status, Converter={x:Static l:Conv.Enum}}" SortMemberPath="Status" Width="90" MinWidth="90" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
