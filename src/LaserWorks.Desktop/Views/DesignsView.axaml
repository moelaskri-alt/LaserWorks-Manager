<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LaserWorks.Desktop.ViewModels"
             xmlns:c="using:LaserWorks.Desktop.Controls"
             xmlns:l="using:LaserWorks.Desktop"
             x:Class="LaserWorks.Desktop.Views.DesignsView"
             x:DataType="vm:DesignsViewModel">
  <DockPanel>
    <c:ListToolbar DockPanel.Dock="Top" Grid="{Binding #grid}" Margin="0,0,0,10">
      <c:ListToolbar.Filters>
        <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" Width="170" />
      </c:ListToolbar.Filters>
      <c:ListToolbar.Actions>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="{l:T Revision.OpenRequest}" Command="{Binding OpenRequestCommand}" CommandParameter="{Binding Selected}" IsEnabled="{Binding Selected, Converter={x:Static l:Conv.NotNull}}" />
          <Button Classes="primary" Command="{Binding OpenCommand}" CommandParameter="{Binding Selected}" IsEnabled="{Binding Selected, Converter={x:Static l:Conv.NotNull}}">
            <StackPanel Orientation="Horizontal" Spacing="6"><l:Ico Data="{StaticResource IcoOpen}" Foreground="White" /><TextBlock Text="{l:T Common.Open}" /></StackPanel>
          </Button>
        </StackPanel>
      </c:ListToolbar.Actions>
    </c:ListToolbar>
    <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{l:T Revision.Hint}" Margin="0,0,0,8" />
    <c:Pager DockPanel.Dock="Bottom" />
    <DataGrid Name="grid" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" l:GridBehaviors.OpenCommand="{Binding OpenCommand}" l:GridBehaviors.RowClasses="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{l:T Col.Request}" Binding="{Binding RequestNumber}" Width="110" MinWidth="110" />
        <DataGridTextColumn Header="{l:T Col.Customer}" Binding="{Binding Customer}" Width="1.4*" MinWidth="98" />
        <DataGridTextColumn Header="{l:T Col.Revision}" Binding="{Binding RevisionLabel}" Width="100" MinWidth="100" />
        <DataGridTextColumn Header="{l:T Col.Date}" Binding="{Binding Date, Converter={x:Static l:Conv.Date}}" Width="100" MinWidth="100" />
        <DataGridTextColumn Header="{l:T Col.Designer}" Binding="{Binding Designer}" Width="*" MinWidth="80" />
        <DataGridTextColumn Header="{l:T Revision.Width}" Binding="{Binding Width, Converter={x:Static l:Conv.Number}}" Width="80" MinWidth="80" />
        <DataGridTextColumn Header="{l:T Revision.Height}" Binding="{Binding Height, Converter={x:Static l:Conv.Number}}" Width="80" MinWidth="80" />
        <DataGridTextColumn Header="{l:T Col.Material}" Binding="{Binding Material}" Width="1.2*" MinWidth="84" />
        <DataGridTextColumn Header="{l:T Col.CuttingLength}" Binding="{Binding CuttingLengthM, Converter={x:Static l:Conv.Number}}" Width="100" MinWidth="100" />
        <DataGridTextColumn Header="{l:T Col.EngravingArea}" Binding="{Binding EngravingAreaCm2, Converter={x:Static l:Conv.Number}}" Width="100" MinWidth="100" />
        <DataGridTextColumn Header="{l:T Col.MachineMinutes}" Binding="{Binding EstimatedMachineMinutes, Converter={x:Static l:Conv.Number}}" Width="90" MinWidth="90" />
        <DataGridTextColumn Header="{l:T Col.Files}" Binding="{Binding Files}" Width="60" MinWidth="60" />
        <DataGridTextColumn Header="{l:T Col.Status}" Binding="{Binding Status, Converter={x:Static l:Conv.Enum}}" Width="110" MinWidth="110" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
