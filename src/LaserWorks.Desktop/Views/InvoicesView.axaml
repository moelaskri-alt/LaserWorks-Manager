<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LaserWorks.Desktop.ViewModels"
             xmlns:c="using:LaserWorks.Desktop.Controls"
             xmlns:l="using:LaserWorks.Desktop"
             x:Class="LaserWorks.Desktop.Views.InvoicesView"
             x:DataType="vm:InvoicesViewModel">
  <DockPanel>
    <c:ListToolbar DockPanel.Dock="Top" Grid="{Binding #grid}" Margin="0,0,0,10">
      <c:ListToolbar.Filters>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" Width="130" />
          <CalendarDatePicker SelectedDate="{Binding From}" Width="130" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" Watermark="{l:T Filter.From}" />
          <CalendarDatePicker SelectedDate="{Binding To}" Width="130" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" Watermark="{l:T Filter.To}" />
          <CheckBox IsChecked="{Binding OpenOnly}" Content="{l:T Filter.UnpaidOnly}" />
        </StackPanel>
      </c:ListToolbar.Filters>
      <c:ListToolbar.Actions>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="{l:T Payment.Record}" Command="{Binding PayCommand}" CommandParameter="{Binding Selected}" IsEnabled="{Binding Selected, Converter={x:Static l:Conv.NotNull}}" />
          <Button Content="{l:T Return.Title}" Command="{Binding ReturnCommand}" CommandParameter="{Binding Selected}" IsEnabled="{Binding Selected, Converter={x:Static l:Conv.NotNull}}" />
          <Button Command="{Binding OpenCommand}" CommandParameter="{Binding Selected}" IsEnabled="{Binding Selected, Converter={x:Static l:Conv.NotNull}}">
            <StackPanel Orientation="Horizontal" Spacing="6"><l:Ico Data="{StaticResource IcoOpen}" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="{l:T Common.Open}" /></StackPanel>
          </Button>
          <Button Classes="primary" Command="{Binding NewCommand}" IsVisible="{Binding CanCreate}">
            <StackPanel Orientation="Horizontal" Spacing="6"><l:Ico Data="{StaticResource IcoPlus}" Foreground="White" /><TextBlock Text="{l:T Invoice.New}" /></StackPanel>
          </Button>
        </StackPanel>
      </c:ListToolbar.Actions>
    </c:ListToolbar>
    <c:Pager DockPanel.Dock="Bottom" />
    <DataGrid Name="grid" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" l:GridBehaviors.ServerSort="True" l:GridBehaviors.OpenCommand="{Binding OpenCommand}" l:GridBehaviors.RowClasses="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{l:T Col.Invoice}" Binding="{Binding Number}" SortMemberPath="Number" Width="110" MinWidth="110" />
        <DataGridTextColumn Header="{l:T Col.Date}" Binding="{Binding Date, Converter={x:Static l:Conv.Date}}" SortMemberPath="Date" Width="95" MinWidth="95" />
        <DataGridTextColumn Header="{l:T Col.DueDate}" Binding="{Binding DueDate, Converter={x:Static l:Conv.Date}}" SortMemberPath="DueDate" Width="95" MinWidth="95" />
        <DataGridTextColumn Header="{l:T Col.Customer}" Binding="{Binding Customer}" SortMemberPath="Customer.Name" Width="1.6*" MinWidth="112" />
        <DataGridTextColumn Header="{l:T Col.Job}" Binding="{Binding JobNumber}" Width="95" MinWidth="95" />
        <DataGridTextColumn Header="{l:T Col.Status}" Binding="{Binding Status, Converter={x:Static l:Conv.Enum}}" SortMemberPath="Status" Width="85" MinWidth="85" />
        <DataGridTextColumn Header="{l:T Col.NetRevenue}" Binding="{Binding NetRevenue, Converter={x:Static l:Conv.Money}}" Width="110" MinWidth="110" />
        <DataGridTextColumn Header="{l:T Col.Tax}" Binding="{Binding TaxAmount, Converter={x:Static l:Conv.Money}}" Width="90" MinWidth="90" />
        <DataGridTextColumn Header="{l:T Col.Total}" Binding="{Binding Total, Converter={x:Static l:Conv.Money}}" SortMemberPath="Total" Width="110" MinWidth="110" />
        <DataGridTextColumn Header="{l:T Col.Paid}" Binding="{Binding PaidAmount, Converter={x:Static l:Conv.Money}}" Width="100" MinWidth="100" />
        <DataGridTextColumn Header="{l:T Col.Balance}" Binding="{Binding Balance, Converter={x:Static l:Conv.Money}}" Width="100" MinWidth="100" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
