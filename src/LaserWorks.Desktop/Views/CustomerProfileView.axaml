<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LaserWorks.Desktop.ViewModels"
             xmlns:l="using:LaserWorks.Desktop"
             x:Class="LaserWorks.Desktop.Views.CustomerProfileView"
             x:DataType="vm:CustomerProfileViewModel">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
        <Button Content="{l:T Customer.Statement}" Command="{Binding StatementCommand}" />
        <Button Content="{l:T Payment.Record}" Command="{Binding RecordPaymentCommand}" />
        <Button Content="{l:T Request.New}" Command="{Binding NewRequestCommand}" />
        <Button Classes="primary" Content="{l:T Common.Edit}" Command="{Binding EditCommand}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Classes="ghost" Command="{Binding BackCommand}" ToolTip.Tip="{l:T Common.Back}">
          <l:Ico Data="{StaticResource IcoChevronLeft}" Foreground="{DynamicResource TextBrush}" />
        </Button>
        <StackPanel>
          <TextBlock Text="{Binding Profile.Customer.Name}" Classes="h2" />
          <TextBlock Classes="muted" Text="{Binding Profile.Customer.Code}" />
        </StackPanel>
      </StackPanel>
    </DockPanel>
    <Border DockPanel.Dock="Top" Classes="banner-error" IsVisible="{Binding ErrorMessage, Converter={x:Static l:Conv.NotEmpty}}" Margin="0,0,0,8">
      <TextBlock Classes="error" Text="{Binding ErrorMessage}" />
    </Border>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,10,*,10,*,10,*,10,*,10,*" Margin="0,0,0,12">
      <Border Classes="card"><StackPanel><TextBlock Classes="label" Text="{l:T Col.Balance}" /><TextBlock Classes="kpi" Text="{Binding Profile.Balance, Converter={x:Static l:Conv.Money}}" /></StackPanel></Border>
      <Border Classes="card" Grid.Column="2"><StackPanel><TextBlock Classes="label" Text="{l:T Col.TotalInvoiced}" /><TextBlock Classes="kpi" Text="{Binding Profile.TotalInvoiced, Converter={x:Static l:Conv.Money}}" /></StackPanel></Border>
      <Border Classes="card" Grid.Column="4"><StackPanel><TextBlock Classes="label" Text="{l:T Col.Revenue}" /><TextBlock Classes="kpi" Text="{Binding Profile.Revenue, Converter={x:Static l:Conv.Money}}" /></StackPanel></Border>
      <Border Classes="card" Grid.Column="6"><StackPanel><TextBlock Classes="label" Text="{l:T Col.GrossProfit}" /><TextBlock Classes="kpi" Text="{Binding Profile.GrossProfit, Converter={x:Static l:Conv.Money}}" Foreground="{Binding Profile.GrossProfit, Converter={x:Static l:Conv.SignBrush}}" /></StackPanel></Border>
      <Border Classes="card" Grid.Column="8"><StackPanel><TextBlock Classes="label" Text="{l:T Col.Margin}" /><TextBlock Classes="kpi" Text="{Binding Profile.MarginPercent, Converter={x:Static l:Conv.Percent}}" /></StackPanel></Border>
      <Border Classes="card" Grid.Column="10"><StackPanel><TextBlock Classes="label" Text="{l:T Col.OpenJobs}" /><TextBlock Classes="kpi" Text="{Binding Profile.OpenJobs}" /></StackPanel></Border>
    </Grid>
    <Grid ColumnDefinitions="300,14,*">
      <Border Classes="card" VerticalAlignment="Top">
        <StackPanel Spacing="8">
          <TextBlock Classes="h3" Text="{l:T Customer.Details}" />
          <TextBlock Classes="label" Text="{l:T Col.Phone}" /><TextBlock Text="{Binding Profile.Customer.Phone}" />
          <TextBlock Classes="label" Text="{l:T Col.Email}" /><TextBlock Text="{Binding Profile.Customer.Email}" />
          <TextBlock Classes="label" Text="{l:T Col.Address}" /><TextBlock Text="{Binding Profile.Customer.Address}" Classes="wrap" />
          <TextBlock Classes="label" Text="{l:T Col.TaxNumber}" /><TextBlock Text="{Binding Profile.Customer.TaxNumber}" />
          <TextBlock Classes="label" Text="{l:T Col.CreditLimit}" /><TextBlock Text="{Binding Profile.Customer.CreditLimit, Converter={x:Static l:Conv.Money}}" />
          <TextBlock Classes="label" Text="{l:T Col.PaymentTermsDays}" /><TextBlock Text="{Binding Profile.Customer.PaymentTermsDays}" />
          <TextBlock Classes="label" Text="{l:T Col.Notes}" /><TextBlock Text="{Binding Profile.Customer.Notes}" Classes="wrap" />
          <Separator />
          <TextBlock Classes="muted" Text="{Binding Profile.Requests, StringFormat='# {0}'}" />
        </StackPanel>
      </Border>
      <DockPanel Grid.Column="2">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
          <TextBlock Classes="h3" Text="{l:T Customer.Documents}" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding DocTypes}" SelectedItem="{Binding DocType}" Width="150">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={x:Static l:Conv.Prefixed}, ConverterParameter=Doc}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Documents}" l:GridBehaviors.OpenCommand="{Binding OpenDocumentCommand}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{l:T Col.Type}" Binding="{Binding TypeLabel}" Width="120" MinWidth="120" />
            <DataGridTextColumn Header="{l:T Col.Number}" Binding="{Binding Number}" Width="140" MinWidth="140" />
            <DataGridTextColumn Header="{l:T Col.Date}" Binding="{Binding Date, Converter={x:Static l:Conv.Date}}" Width="110" MinWidth="110" />
            <DataGridTextColumn Header="{l:T Col.Status}" Binding="{Binding StatusLabel}" Width="*" MinWidth="80" />
            <DataGridTextColumn Header="{l:T Col.Amount}" Binding="{Binding Amount, Converter={x:Static l:Conv.Money}}" Width="140" MinWidth="140" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
